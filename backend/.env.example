MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=travelsync

# Generate a real secret for this, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=10080

# Set to true only when serving the API over HTTPS in production
COOKIE_SECURE=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development
