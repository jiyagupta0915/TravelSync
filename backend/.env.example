# Copy to .env (never commit the real file) and fill in your own values.

# development | production. In production the app refuses to start with a weak secret,
# an insecure cookie, or a wildcard CORS origin.
ENVIRONMENT=development

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=travelsync

# REQUIRED in production: a long random value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRES_MINUTES=10080

# Cookies. COOKIE_SECURE defaults to true when ENVIRONMENT=production.
# Set false only for plain-http local development.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Exact browser origin(s) of the frontend, comma separated. Used for CORS and the CSRF origin check.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Login throttling (per process)
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900

# Stay recommendations (https://www.geoapify.com/ - free tier). Without it the Stays feature shows a clear
# "not set up" message instead of results.
GEOAPIFY_API_KEY=

# Assistant (optional). The chatbot answers from TravelSync's own data and works with no key. Set a key to let an
# AI model answer the questions it can't. Any OpenAI-compatible chat API works. The provider is recognised from
# the key for Groq (gsk_...) and xAI Grok (xai-...); for anything else set ASSISTANT_BASE_URL too.
# ASSISTANT_MODEL must be a model your key can use - check the provider's console, the free list changes.
#   Groq:  ASSISTANT_BASE_URL=https://api.groq.com/openai/v1   e.g. ASSISTANT_MODEL=openai/gpt-oss-120b
#   xAI:   ASSISTANT_BASE_URL=https://api.x.ai/v1
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_TIMEOUT_SECONDS=8

# Password recovery by email. Leave SMTP_HOST empty to keep recovery disabled (the UI then says so).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_MINUTES=30
